.group-box {
    background-color: rgba(52, 52, 52, 1);
    border-radius: 4px;
    padding: 6px;
    margin: 2px 0;
    border-color: rgba(30, 30, 30, 1);
    border-width: 1px;
}

.custom-tool-root
{
    padding: 4px;
}

.core-init-title
{
    font-size: 14px;
    -unity-font-style: bold;
}

.core-init-setup-button
{
    background-color: rgba(50, 101, 50, 1);
}

.core-init-setup-button:hover
{
    background-color: rgba(70, 145, 60, 1);
}

.palette-grid
{
    flex-direction: row;
    flex-wrap: wrap;
}

.palette-item
{
    width: 48px;
    height: 48px;
    margin: 2px;
    padding: 2px;
    background-color: rgba(60, 60, 60, 1);
    border-width: 2px;
    border-color: rgba(60, 60, 60, 1);
}

.palette-item-selected
{
    border-color: rgba(80, 160, 255, 1);
}

/* Width must match CellWidth in TeamsSettingsEditor.cs. */
.teams-matrix-cell
{
    width: 26px;
    align-items: center;
    justify-content: center;
}

.teams-matrix-toggle
{
    margin-left: 0;
    margin-right: 0;
}

.toggle-button-row
{
    flex-direction: row;
}

/* USS has no :first-child/:last-child selectors, so the outer-only rounding below is applied via explicit
   toggle-button-first/toggle-button-last marker classes added in code, not a structural selector. */
.toggle-button
{
    flex-grow: 1;
    margin: 0;
    border-left-width: 0;
    border-radius: 0;
}

.toggle-button-first
{
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.toggle-button-last
{
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

.toggle-button-active
{
    background-color: rgba(70, 130, 180, 1);
}

.arrange-apply-button
{
    width: 180px;
    height: 40px;
    align-self: center;
}